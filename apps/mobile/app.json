{
  "expo": {
    "name": "The Last Voyage",
    "slug": "last-voyage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hackthenest.lastvoyage"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#27187E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hackthenest.lastvoyage",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#27187E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "react-native-health-connect",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-web-browser",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Hold the talk button to speak to your ship's narrator. The mic is only used while you hold it.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "scheme": "lastvoyage",
    "experiments": {
      "typedRoutes": true
    }
  }
}
