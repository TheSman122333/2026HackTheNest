{
  "expo": {
    "name": "The Last Voyage",
    "slug": "last-voyage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hackthenest.lastvoyage",
      "infoPlist": {
        "NSCameraUsageDescription": "Take an optional face photo to fit inside your pirate avatar. Your photo stays on this device.",
        "NSPhotoLibraryUsageDescription": "Choose an optional face photo for your pirate avatar. Your photo stays on this device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#073A6B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hackthenest.lastvoyage",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "The Last Voyage",
      "shortName": "Last Voyage",
      "themeColor": "#073A6B",
      "backgroundColor": "#073A6B",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#073A6B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "react-native-health-connect",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-web-browser",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Hold the talk button to speak to your ship's narrator. The mic is only used while you hold it.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "scheme": "lastvoyage",
    "experiments": {
      "typedRoutes": true
    }
  }
}
