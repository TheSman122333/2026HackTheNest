# MongoDB Atlas connection string (Database > Connect > Drivers)
# Leave empty to use a local MongoDB that starts automatically.
# MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=last_voyage
# any long random string
JWT_SECRET=change-me-to-a-long-random-string
PORT=8787

# --- Sponsor integrations (all optional; features fall back to text when unset) ---
# SSOJet (OIDC). SSOJet only allows http(s) callbacks: use the server bridge below and add it in SSOJet
SSOJET_ISSUER=
SSOJET_CLIENT_ID=
SSOJET_CLIENT_SECRET=
SSOJET_AUDIENCE=
SSOJET_REDIRECT_URI=http://localhost:8787/auth/ssojet/callback
# Game Master world events
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Tidekeeper brain + narration: Gemini first when set, OpenAI as backup
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# EXA_API_KEY=  (optional: if set, Exa is used for search instead of OpenAI web search)
# true = a new GM event on every button press (demo); otherwise one per crew/island/day
GM_DEMO_REPEAT=true
# Narrator voice (speech-to-text + text-to-speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# End the Year (awards the one Lodestar) needs this password; unset = locked
LODESTAR_PASSWORD=
